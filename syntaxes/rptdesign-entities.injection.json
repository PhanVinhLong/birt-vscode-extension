{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BIRT embedded script XML entities",
  "scopeName": "rptdesign.entities.injection",
  "injectionSelector": "L:meta.embedded.block.javascript -string -comment, L:meta.embedded.line.javascript -string -comment",
  "patterns": [{ "include": "#xml-entity" }],
  "repository": {
    "xml-entity": {
      "name": "constant.character.entity.xml",
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);"
    }
  }
}
